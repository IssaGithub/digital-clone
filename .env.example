DATABASE_URL=postgresql://klon:klon@localhost:5432/klon
ENCRYPTION_KEY=ersetze-mich-mit-64-hex-zeichen
SESSION_SECRET=ersetze-mich
VOICE_SHARED_SECRET=ersetze-mich
APP_URL=http://localhost:3000
VOICE_PORT=3001
VOICE_PUBLIC_WS_URL=ws://localhost:3001/recall
RECALL_API_BASE=https://us-west-2.recall.ai

# Plattform-OAuth. Leer lassen: die Karten bleiben sichtbar und zeigen den fehlenden Anschluss.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional. Wenn gesetzt, verlangt das Dashboard dieses Passwort.
DASHBOARD_PASSWORD=

# LiveKit. Lokal nutzt der Dev-Server die öffentlichen Dev-Keys. Auf dem Server eigene Werte nur in der Server-.env.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
AGENT_PORT=4010
CALL_ORIGIN=http://127.0.0.1:4200

# Fallback, bis sich ein Nutzer bei OpenAI anmeldet. Der OAuth-Token liegt verschlüsselt in der Datenbank.
OPENAI_API_KEY=
OPENAI_OAUTH_CLIENT_ID=
# Nur diese Loopback-Adresse ist ohne registrierten Client erlaubt.
OPENAI_REDIRECT_URI=http://127.0.0.1:4010/auth/callback
OPENAI_REDIRECT_REGISTERED=
OPENAI_AGENT_HOST_ID=
